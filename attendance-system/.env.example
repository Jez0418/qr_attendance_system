# Copy these into Vercel -> Project -> Settings -> Environment Variables
# (Supabase dashboard -> Connect -> "Session pooler" gives host/port/user)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASS=<your-database-password>
DB_SSL=1

# --- Security / optional ---
# Long random string used to sign QR payloads (generate: php -r "echo bin2hex(random_bytes(32));").
# If omitted, a key is derived from the DB credentials. Changing it invalidates QR codes already on screen.
QR_SECRET_KEY=
# Set to 1 ONLY on a local test machine to show demo logins on the login page.
SHOW_DEMO_LOGINS=
